<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bibliotek.Avalonia.ViewModels"
        x:Class="Bibliotek.Avalonia.Views.BookDetailWindow"
        x:DataType="vm:BookDetailViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Bog detaljer"
        Width="400" Height="380">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Rediger bog" FontSize="18" FontWeight="Bold"/>

        <TextBlock Text="Titel:"/>
        <TextBox Text="{Binding EditTitle}"/>

        <TextBlock Text="Forfatter:"/>
        <TextBox Text="{Binding EditAuthor}"/>

        <Button Content="Gem ændringer" 
                Command="{Binding SaveChangesCommand}"
                Background="#4CAF50" Foreground="White"/>
        
        <Button Content="Slet bog" 
                Command="{Binding DeleteBookCommand}"
                Background="#E57373" Foreground="White"/>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <TextBlock Text="{Binding BorrowerInfo}" FontWeight="SemiBold"/>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="DarkBlue"/>
    </StackPanel>
</Window>