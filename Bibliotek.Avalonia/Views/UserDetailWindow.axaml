<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Bibliotek.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Bibliotek.Avalonia.Views.UserDetailWindow"
        x:DataType="vm:UserDetailViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding SelectedUser.Name, StringFormat='Bruger detaljer: {0}'}"
        MinWidth="700" MinHeight="350"
        Width="800" Height="450">

  <Grid ColumnDefinitions="*,*" Margin="15" RowDefinitions="Auto,Auto,*">
        
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" 
                   Text="{Binding StatusMessage}" 
                   FontWeight="Bold" Margin="0,0,0,10" Foreground="DarkBlue"/>
        
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBox Text="{Binding EditName}" Width="250" PlaceholderText="Nyt navn"/>
            <Button Content="Gem ændringer" 
                    Command="{Binding SaveChangesCommand}"
                    Background="#4CAF50" Foreground="White"/>
            <Button Content="Slet bruger" 
                    Command="{Binding DeleteUserCommand}"
                    Background="#E57373" Foreground="White"/>
        </StackPanel>

        <!-- ========================================== -->
        <!-- COL 1: Borrowed Books & Return Button      -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0" Padding="10">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="{Binding BorrowedBooksHeader}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding BorrowedBooks}" 
                         SelectedItem="{Binding SelectedBorrowedBook}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" 
                        Content="Returner valgt bog" 
                        Command="{Binding ReturnBookCommand}" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,10,0,0"
                        Background="#E57373" Foreground="White"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- COL 2: Available Books & Search Bar        -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="10,0,0,0" Padding="10">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Tilgængelige bøger" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <TextBox Grid.Row="1"
                         PlaceholderText="Søg efter titel..." 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10"/>

                <TableView Grid.Row="2"
                           ItemsSource="{Binding AvailableBooks}" 
                           SelectedItem="{Binding SelectedAvailableBook}" 
                           CanUserResizeColumns="False">
                    <TableView.Columns>
                        <TableViewColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
                        <TableViewColumn Header="Forfatter" Binding="{Binding Author}" Width="*"/>
                        <TableViewColumn Header="ISBN" Binding="{Binding ISBN}" Width="*"/>
                    </TableView.Columns>
                </TableView>

                <Button Grid.Row="3"
                        Content="Lån valgt bog" 
                        Command="{Binding BorrowBookCommand}" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,10,0,0"
                        Background="#4CAF50" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>
